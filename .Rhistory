medias_grupo <- data_ROIs %>%
group_by(Group) %>%
summarize(mean_val = mean(distres_global, na.rm = TRUE))
grafica_2B <- ggplot(data_ROIs, aes(x = Group, y = distres_global, fill = Group, color = Group)) +
ggdist::stat_halfeye(
adjust = 0.5,
width = 0.5,
.width = 0,
justification = -0.3,
point_colour = NA,
alpha = 0.20
) +
geom_boxplot(
aes(fill = Group),
color = "black",
width = 0.25,
outlier.shape = NA,
alpha = 0.65,
linewidth = 0.8
) +
geom_jitter(
width = 0.12,
height = 0,
size = 2.7,
alpha = 1.0,
stroke = 0.1
) +
geom_point(
data = medias_grupo,
aes(x = Group, y = mean_val),
shape = 18,
size = 4,
color = "black",
inherit.aes = FALSE
) +
geom_label(
data = medias_grupo,
aes(x = Group, y = mean_val, label = round(mean_val, 2)),
color = "black",
fontface = "bold",
size = 4,
vjust = -1.4,
hjust = 0.5,
fill = "white",
label.padding = unit(0.2, "lines"),
label.size = 0.3
) +
scale_fill_manual(values = colores_grafica) +
scale_color_manual(values = colores_grafica) +
labs(
x = "Group",
y = "Psychological Distress (PC1)"
) +
coord_flip() +
theme_classic(base_size = 14) +
theme(
legend.position = "none",
axis.line = element_line(color = "black", linewidth = 0.6),
axis.text = element_text(color = "black"),
axis.title.x = element_text(margin = margin(t = 12), face = "bold", color = "black"),
axis.title.y = element_text(margin = margin(r = 12), face = "bold", color = "black")
)
print(grafica_2B)
# Exportar en alta resolución (300 DPI)
ggsave(
filename = "./IMAGES/Figure3_Global_DistressXGroup.png",
plot = grafica_2B,
width = 5.5,
height = 6,
units = "in",
dpi = 300
)
